{
  "name": "Platter",
  "version": "1.35.0",
  "description": "在同一個視窗內管理多個 AI 平台Web帳號的桌面應用程式",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:dir": "electron-builder --dir"
  },
  "author": "Kikulu",
  "license": "MIT",
  "dependencies": {
    "docx": "^9.7.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.3.3"
  },
  "build": {
    "appId": "com.kikulu.platter",
    "productName": "Platter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "extractors/**/*",
      "!node_modules/sql.js/dist/*.zip",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/worker.*",
      "!node_modules/sql.js/dist/*-browser*",
      "!node_modules/sql.js/dist/*-debug.*",
      "!node_modules/pdf-lib/{dist,es,ts3.4,src}/**",
      "!node_modules/docx/dist/*.{mjs,d.ts,d.cts}",
      "!node_modules/docx/dist/*.{iife,umd}.*",
      "!node_modules/docx/dist/{charts,math,shapes,watermarks}.cjs",
      "!node_modules/mammoth/{test,browser}/**",
      "!node_modules/mammoth/mammoth.browser*.js",
      "!node_modules/jszip/dist/**",
      "!node_modules/pako/dist/**",
      "!node_modules/xml-js/dist/**",
      "!node_modules/underscore/{modules,amd}/**",
      "!node_modules/underscore/{underscore,underscore-esm}.js",
      "!node_modules/@pdf-lib/standard-fonts/{dist,es}/**",
      "!node_modules/@pdf-lib/upng/dist/**",
      "!node_modules/@types/**",
      "!node_modules/undici-types/**",
      "!node_modules/**/*.{map,d.ts,d.cts,md,markdown}",
      "!node_modules/**/{yarn.lock,CHANGES*,CHANGELOG*}"
    ],
    "asarUnpack": [
      "extractors/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Platter"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  }
}
